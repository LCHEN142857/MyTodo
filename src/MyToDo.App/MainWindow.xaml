<Window x:Class="MyToDo.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyToDo.App.ViewModels"
        xmlns:conv="clr-namespace:MyToDo.App.Converters"
        Width="320" Height="520" MinWidth="260" MinHeight="320"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <conv:PageVisibilityConverter x:Key="PageVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>
    <Border CornerRadius="6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
            <Grid x:Name="DragRegion" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Margin="14,0,0,0"><TextBlock Text="MyToDo" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=ToDo}" /><TextBlock Text="History" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=History}" /></Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="HistoryButton" Content="History" Command="{Binding ShowHistoryCommand}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=ToDo}" />
                    <Button x:Name="TodoButton" Content="To Do" Command="{Binding ShowTodoCommand}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=History}" />
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" ToolTip="Keep on top" AutomationProperties.Name="Toggle always on top" Click="PinButton_Click"><Path Fill="{StaticResource TextBrush}" Data="M8,2 L16,2 L16,8 L19,11 L19,13 L13,13 L13,21 L11,21 L11,13 L5,13 L5,11 L8,8 Z" /></Button>
                    <Button x:Name="SettingsButton" Content="S" Width="28" ToolTip="Settings" AutomationProperties.Name="Open settings" Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="10,4,10,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBox x:Name="NewTodoInput" Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewTodoInput_KeyDown" /><Button x:Name="AddTodoButton" Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Add todo" AutomationProperties.Name="Add todo" Command="{Binding CreateCommand}"><Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" Data="M12,5 L12,19 M5,12 L19,12" /></Button></Grid>
            <TextBox x:Name="SearchInput" Grid.Row="2" Margin="10,0,10,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search todos" />
            <ListBox x:Name="TodoList" Grid.Row="3" ItemsSource="{Binding VisibleItemsView}" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="8,0">
                <ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:TodoItemViewModel}"><Grid Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox VerticalAlignment="Center" Click="CompleteCheckBox_Click" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter=ToDo}" /><TextBlock x:Name="TodoText" Grid.Column="1" Text="{Binding Content}" TextWrapping="Wrap" VerticalAlignment="Center" MouseLeftButtonDown="TodoText_MouseLeftButtonDown" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter=ToDo}" /><TextBox Grid.Column="1" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}" KeyDown="EditText_KeyDown" LostFocus="EditText_LostFocus" /><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" ToolTip="Restore todo" AutomationProperties.Name="Restore todo" Command="{Binding RestoreCommand}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter=History}"><Path Stroke="{StaticResource CompletedBrush}" StrokeThickness="2" Data="M5,12 A7,7 0 1 1 12,19 M12,5 L12,1 M12,1 L16,5" /></Button><Button Style="{StaticResource IconButton}" ToolTip="Delete todo" AutomationProperties.Name="Delete todo" Command="{Binding DeleteCommand}"><Path Stroke="{StaticResource DangerBrush}" StrokeThickness="2" Data="M6,6 L18,18 M18,6 L6,18" /></Button></StackPanel><TextBlock x:Name="HistoryText" Grid.Column="1" Text="{Binding Content}" TextDecorations="Strikethrough" Foreground="{StaticResource MutedBrush}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter=History}" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Row="4" Margin="10,0"><TextBlock Text="{Binding TodoCount, StringFormat={}{0} todos}" VerticalAlignment="Center" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=ToDo}" /><TextBlock Text="{Binding HistoryCount, StringFormat={}{0} completed}" VerticalAlignment="Center" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=History}" /><Button x:Name="CleanHistoriesButton" DockPanel.Dock="Right" Content="Clean histories" Command="{Binding ClearHistoryCommand}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=History}"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding HistoryCount}" Value="0"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></DockPanel>
            <Border x:Name="SettingsPopup" Grid.Row="0" Grid.RowSpan="5" Background="#F7FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,38,8,0" Width="190" Visibility="Collapsed"><StackPanel><TextBlock Text="Opacity Settings" FontWeight="SemiBold" Margin="0,0,0,10" /><Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" Value="{Binding ElementName=RootWindow, Path=Opacity, Mode=TwoWay}" TickFrequency="0.05" /><TextBlock Text="{Binding ElementName=RootWindow, Path=Opacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" /><Button x:Name="ExitButton" Content="Exit" Click="ExitButton_Click" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" /></StackPanel></Border>
        </Grid>
    </Border>
</Window>
