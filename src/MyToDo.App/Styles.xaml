<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#202124" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="CompletedBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource SurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="FontFamily" Value="Segoe UI" /></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="White" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="8,5" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style x:Key="IconButton" TargetType="Button"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="5" /><Setter Property="Margin" Value="2,0,0,0" /></Style>
    <Style TargetType="ListBox"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="BorderThickness" Value="0" /></Style>
</ResourceDictionary>
